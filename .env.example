APP_NAME="ISL Translation System"
APP_VERSION="1.0.0"
DEBUG=false

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
SPACY_MODEL=en_core_web_sm

ANIMATION_FPS=30
INTERPOLATION_FRAMES=10
IDLE_ANIMATION_ENABLED=true

DATABASE_URL=sqlite+aiosqlite:///./isl_history.db
CACHE_MAX_SIZE=256

GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

SLT_DATASET_DIR=./slt_data
ISL_LANDMARKS_DIR=../isl/extracted_data
ISL_DATASET_FPS=15
ISL_MOTION_CLIPS_DIR=../isl/motion_clips
